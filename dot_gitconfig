[color]
    ui = auto
[user]
    name = CPea
    email = cpea2506@gmail.com
[init]
    defaultBranch = main
[includeIf "gitdir:~/Developer/Works/"]
    path = ~/Developer/Works/.gitconfig
[core]
    excludesfile = ~/.globalgitignore
    editor = nvim
    compression = 0
    pager = delta
    sshCommand = "ssh -i ~/.ssh/id_ed25519_personal"
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
[fetch]
    prune = true
[delta]
    navigate = true
    side-by-side = true
[interactive]
    diffFilter = delta --color-only
[merge]
    conflictStyle = zdiff3
    tool = codediff
[mergetool "codediff"]
    cmd = nvim \"$MERGED\" -c \"CodeDiff merge \\\"$MERGED\\\"\"
[diff]
    tool = codediff
[difftool "codediff"]
    cmd = nvim \"$LOCAL\" \"$REMOTE\" +\"CodeDiff file $LOCAL $REMOTE\"
